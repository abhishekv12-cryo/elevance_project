PORT=5000
# Leave MONGO_URI empty to use the built-in embedded MongoDB (zero setup).
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/qa_platform
JWT_SECRET=change-me
CLIENT_URL=http://localhost:5173
# SMTP (if empty, emails/OTPs/SMS are printed to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
# Razorpay (if empty, a mock gateway is used)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# DEMO DEFAULT = 1 so every feature can be tried at any hour. Set 0 for the strict 10AM-1PM mobile / 10-11AM payment rules.
# 1 = disable the 10AM-1PM mobile-login and 10-11AM payment windows (local demos only)
BYPASS_TIME_WINDOWS=1
TRUST_PROXY=0
